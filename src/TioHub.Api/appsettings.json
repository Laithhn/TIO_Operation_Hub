{
  "ConnectionStrings": {
    "TioHub": "Server=SQLSERVER_HOST;Database=TioHub;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;Application Name=TIO Operations Hub"
  },
  "App": {
    "EnvironmentName": "Production",
    "SupportContact": "",
    "MapTileUrl": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "MapAttribution": "© OpenStreetMap contributors"
  },
  "Auth": {
    "Mode": "Forms",
    "SessionMinutes": 480,
    "LockoutAttempts": 5,
    "LockoutMinutes": 15,
    "SetupCodeFile": "App_Data/setup-code.txt",
    "BootstrapAdministrators": [],
    "CacheSeconds": 60
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedReferenceData": true,
    "SeedDevelopmentData": false,
    "CompatibilityLevel": 150
  },
  "Attachments": {
    "Path": "App_Data/attachments",
    "MaxFileMB": 25,
    "MaxFilesPerUpload": 10
  },
  "Quality": {
    "ScanMinutes": 5
  },
  "Notifications": {
    "ScanMinutes": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tiohub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
