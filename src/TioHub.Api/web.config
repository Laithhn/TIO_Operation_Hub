<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\TioHub.Api.exe" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- A46: attachment uploads (up to 10 files of 25 MB by default). IIS otherwise refuses requests over about 30 MB. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="272629760" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
